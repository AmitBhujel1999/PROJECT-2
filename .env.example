# ---------------------------------------------------------------------------
# Accounting & Inventory System — environment configuration
# Copy to .env and change every value marked CHANGE-ME before production use.
# Never commit the real .env file.
# ---------------------------------------------------------------------------

# Django
DEBUG=False
SECRET_KEY=CHANGE-ME-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Set to True when the site is served over HTTPS (enables HSTS, secure cookies, SSL redirect)
USE_HTTPS=False

# Database (used by the backend container)
POSTGRES_DB=accounting
POSTGRES_USER=accounting
POSTGRES_PASSWORD=CHANGE-ME-db-password
DATABASE_URL=postgresql://accounting:CHANGE-ME-db-password@db:5432/accounting

# Initial administrator created on first start (only if no users exist)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=CHANGE-ME-admin-password

# Load development/demo seed data on start (never enable in production)
LOAD_DEMO_DATA=False

# Email (password reset). Console backend prints emails to the backend log.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com

# Public URL of the frontend (used in password-reset links)
FRONTEND_URL=http://localhost

# Port nginx is published on
HTTP_PORT=80
