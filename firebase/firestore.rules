rules_version = '2';

// Mero Lekhapal online copy. The PC program (anonymous account = book owner) uploads pages;
// phones paired on the local network are members and may read the pages their role allows.
service cloud.firestore {
  match /databases/{database}/documents {
    function book(b) {
      return get(/databases/$(database)/documents/books/$(b)).data;
    }
    function isOwner(b) {
      return request.auth != null && book(b).owner == request.auth.uid;
    }
    function isMember(b) {
      return request.auth != null && request.auth.uid in book(b).members;
    }

    // Typed pairing code ("K7P2-M9QX") -> book and one-time code; written by the PC, read by a phone
    // that knows the code. Each lasts 10 minutes.
    match /codes/{c} {
      allow get: if request.auth != null && resource.data.expires > request.time;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }

    match /books/{b} {
      allow get: if request.auth != null
        && (resource.data.owner == request.auth.uid || request.auth.uid in resource.data.members);
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.owner == request.auth.uid;

      match /views/{view} {
        allow get: if isOwner(b)
          || (isMember(b) && (resource.data.perm == '' || resource.data.perm in book(b).members[request.auth.uid].perms));
        allow write: if isOwner(b);
      }

      // A sale or receipt made on a phone, waiting for the PC to book it. The document id is the
      // number the phone gave it, in the phone's own series (M1-000001 / M1-R-000001).
      match /outbox/{number} {
        allow create: if isMember(b) && book(b).entry == true
          && request.resource.data.uid == request.auth.uid
          && number.matches(book(b).members[request.auth.uid].prefix + '-(R-)?[0-9]{6}')
          && ((request.resource.data.kind == 'sale' && !number.matches('.*-R-.*')
                && 'sales.create' in book(b).members[request.auth.uid].perms)
              || (request.resource.data.kind == 'receipt' && number.matches('.*-R-.*')
                && 'receipts.create' in book(b).members[request.auth.uid].perms));
        allow get, list, delete: if isOwner(b);
      }

      // What happened to it (booked / failed), for the phone that made it.
      match /results/{number} {
        allow get: if isMember(b) && resource.data.uid == request.auth.uid;
        allow list, write: if isOwner(b);
      }

      // A phone asking to join with the one-time code the PC showed (the code is the document id).
      match /pairing/{code} {
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && code.size() == 32;
        allow get, list, delete: if isOwner(b);
      }
    }
  }
}
