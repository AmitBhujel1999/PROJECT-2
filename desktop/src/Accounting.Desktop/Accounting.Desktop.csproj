<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Accounting.Core\Accounting.Core.csproj" />
    <ProjectReference Include="..\Accounting.Server\Accounting.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>MeroLekhapal</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Mero Lekhapal - Accounting &amp; Inventory</Product>
  </PropertyGroup>

  <!-- The web screens (frontend: ADAPTER=static bun run build) are served by the built-in server from "web". -->
  <ItemGroup>
    <Content Include="..\..\..\frontend\build-static\**\*" LinkBase="web" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
